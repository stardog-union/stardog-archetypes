# How many fighter aircraft are there? (domain-only control)
# Run with reasoning on against both example databases (see ../README.md).
# expected without archetype: 10
# expected with bfo_cco:      10 (identical: the archetype does not change domain answers)
# why: Domain class counts with reasoning on are identical with and without the archetype.
PREFIX : <https://example.org/fleet#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX bfo_cco: <urn:stardog:archetype:bfo_cco#>

SELECT (COUNT(DISTINCT ?a) AS ?fighterAircraft)
FROM <urn:fleet:kg>
WHERE { ?a a :FighterAircraft . }
