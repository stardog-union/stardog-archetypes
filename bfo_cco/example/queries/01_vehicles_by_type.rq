# How many vehicles are there, by CCO vehicle type?
# Run with reasoning on against both example databases (see ../README.md).
# expected without archetype: no rows (the fleet ontology has no notion of "vehicle")
# expected with bfo_cco:      Aircraft 14, Ground Vehicle 11, Spacecraft 2
# why: Alignment axioms put each fleet class under a CCO class, so CCO categories work over data that never mentions them.
PREFIX : <https://example.org/fleet#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX bfo_cco: <urn:stardog:archetype:bfo_cco#>

SELECT ?vehicleType (COUNT(DISTINCT ?v) AS ?count)
FROM <urn:fleet:kg>
WHERE {
  { ?v a cco:ont00001043 . BIND("Aircraft" AS ?vehicleType) }
  UNION { ?v a cco:ont00000618 . BIND("Ground Vehicle" AS ?vehicleType) }
  UNION { ?v a cco:ont00001139 . BIND("Spacecraft" AS ?vehicleType) }
}
GROUP BY ?vehicleType ORDER BY ?vehicleType
